# ============================================================
# AgriFlow Pro - Backend Environment Variables
# ============================================================
# Copia este archivo como .env y llena los valores reales:
#   cp .env.example .env
# ============================================================

# URL de conexión a la base de datos PostgreSQL
# Formato: postgresql://USUARIO:CONTRASEÑA@HOST:PUERTO/NOMBRE_BD
DATABASE_URL="postgresql://agro_user:agro_password@localhost:5432/agro_flow"

# Puerto en el que corre el backend (por defecto: 8080)
PORT=8080
